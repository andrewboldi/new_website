---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Scene from '@/components/Scene.astro';
import MorphBackground from '@/components/MorphBackground.astro';
import { EXPERIENCE, PROJECTS, PROJECT_CATEGORIES } from '@/lib/data';

const featured = PROJECTS.filter((p) => p.featured);
const rest = PROJECTS.filter((p) => !p.featured);
const ordered = [...featured, ...rest];
const liveCount = PROJECTS.filter((p) => p.link || p.live).length;
---

<Base title="Work" description="Research, internships, and projects — from total synthesis at Caltech to molecular ML at Soley Therapeutics.">
  <MorphBackground />
  <div class="page-body page-body--solidtop">
  <PageHeader
    eyebrow="Work · research & projects"
    title="What I’ve built,<br/>and figured out."
    lede="A decade of curiosity, roughly: molecular machine learning, total synthesis at the bench, deep learning systems, and a long tail of things made because they were interesting."
  />

  <!-- ===== EXPERIENCE / RESEARCH ===== -->
  <section class="section xp">
    <div class="wrap">
      <h2 class="sec-title display" data-reveal>Research &amp; work</h2>
      <p class="sec-lede muted" data-reveal>
        Three years at the bench in the Stoltz Lab at Caltech, then molecular machine
        learning at Soley Therapeutics — chemistry from both sides of the screen.
      </p>
      <div class="xp__list">
        {EXPERIENCE.map((e, i) => (
          <article class="xp__item" data-reveal data-reveal-delay={i * 70}>
            <div class="xp__rail" aria-hidden="true"><span class="xp__dot"></span></div>
            <div class="xp__when mono">
              <span class={`xp__kind xp__kind--${e.kind}`}>{e.kind}</span>
              <span>{e.when}</span>
              <span class="faint">{e.where}</span>
            </div>
            <div class="xp__body card ticks">
              <h3 class="xp__role">{e.role}</h3>
              <p class="xp__org">{e.org} <span class="faint">· {e.detail}</span></p>
              <ul class="xp__highlights">
                {e.highlights.map((h) => <li>{h}</li>)}
              </ul>
              {e.link && (
                <a class="xp__link mono" href={e.link.href} target="_blank" rel="noopener noreferrer">
                  {e.link.label} ↗
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== INTERLUDE SCENE ===== -->
  <section class="interlude">
    <Scene name="molecule" pdb="ineleganolide" class="abs-fill interlude__scene" label="A rotating ball-and-stick model of ineleganolide, a polycyclic norcembranoid." />
    <div class="wrap interlude__text">
      <p class="eyebrow" data-reveal>At the bench &amp; in silico</p>
      <p class="interlude__quote display" data-reveal>
        “A fragment of <em>ineleganolide</em> — then teaching a model to plan the
        route itself.”
      </p>
      <p class="interlude__cap mono" data-reveal>ineleganolide · a polycyclic norcembranoid diterpene</p>
    </div>
  </section>

  <!-- ===== PROJECTS — pinned horizontal-scroll gallery ===== -->
  <!--
    Outer section is tall (height set in JS = track travel + one viewport) to
    provide vertical scroll length. The sticky child locks to the viewport while
    vertical scroll is mapped onto the track's horizontal translateX.
    Under prefers-reduced-motion the pin is skipped and the track renders as the
    normal responsive grid (see the @media block in <style>).
  -->
  <section class="section projects hscroll" id="projGallery" data-hscroll>
    <div class="hscroll__sticky" data-hscroll-sticky>
      <!-- sticky header: title + stats + filter chips travel with the pin -->
      <header class="hscroll__head wrap">
        <div class="hscroll__headrow">
          <h2 class="sec-title display hscroll__title">Selected projects</h2>
          <div class="projstats mono">
            <span class="projstats__item"><b>{PROJECTS.length}</b> projects</span>
            <span class="projstats__sep" aria-hidden="true">·</span>
            <span class="projstats__item"><b>{PROJECT_CATEGORIES.length}</b> fields</span>
            <span class="projstats__sep" aria-hidden="true">·</span>
            <span class="projstats__item"><b>{liveCount}</b> with source / live links</span>
          </div>
        </div>
        <div class="filters" role="group" aria-label="Filter projects by category">
          <button type="button" class="chip chip--on" data-filter="all" aria-pressed="true">All</button>
          {PROJECT_CATEGORIES.map((c) => (
            <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>
          ))}
        </div>
        <p class="hscroll__hint mono" aria-hidden="true">scroll to glide sideways →</p>
      </header>

      <!-- horizontally clipped viewport + transformed track -->
      <div class="hscroll__viewport" data-hscroll-viewport>
        <div class="hscroll__track" id="projGrid" aria-live="polite" data-hscroll-track>
          {ordered.map((p, i) => (
            <article
              class={`card ticks proj ${p.featured ? 'proj--feat' : ''}`}
              data-cat={p.category}
              data-cardfx={p.anim ?? 'notegraph'}
              data-cardfx-seed={i + 1}
              tabindex="0"
              aria-label={`${p.name} — ${p.category}${p.metric ? `. ${p.metric}` : ''}`}
            >
              <canvas class="cardfx-canvas" aria-hidden="true"></canvas>
              <div class="proj__inner">
                <div class="proj__top">
                  <h3 class="proj__name"><span class="proj__name-line">{p.name}</span></h3>
                  <div class="proj__badges">
                    {p.featured && <span class="tag tag--accent">★ Featured</span>}
                    <span class="proj__cat mono">{p.category}</span>
                  </div>
                </div>

                <p class="proj__blurb muted">{p.blurb}</p>

                {p.metric && (
                  <p class="proj__metric mono" aria-hidden="true">
                    <span class="proj__metric-mark">▸</span>{p.metric}
                  </p>
                )}

                <div class="proj__foot">
                  <div class="proj__tags">
                    {p.lang && <span class="tag tag--lang">{p.lang}</span>}
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                  <div class="proj__links">
                    {typeof p.stars === 'number' && (
                      <span class="proj__stars mono" title={`${p.stars} GitHub stars`}>
                        ★ {p.stars}
                      </span>
                    )}
                    {p.link && (
                      <a class="proj__link mono" href={p.link.href} target="_blank" rel="noopener noreferrer">
                        {p.link.href.includes('github.com') ? 'Source' : p.link.label} ↗
                      </a>
                    )}
                    {p.live && (
                      <a class="proj__link proj__link--live mono" href={p.live.href} target="_blank" rel="noopener noreferrer">
                        Live ↗
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="projects__empty mono" id="projEmpty" hidden>No projects in this category.</p>
      </div>

      <!-- progress rail: current / total + scrub bar -->
      <div class="hscroll__rail wrap" aria-hidden="true">
        <span class="hscroll__index mono"><b data-rail-index>01</b> / <span data-rail-total>{ordered.length.toString().padStart(2, '0')}</span></span>
        <span class="hscroll__bar"><span class="hscroll__barfill" data-rail-fill></span></span>
      </div>
    </div>
  </section>
  </div>

  <script>
    import { startCardFx, type CardFxController } from '@/lib/cardfx/engine';
    import { startWorkHScroll, type HScrollController } from '@/scripts/work-hscroll';
    import { scrollToY } from '@/scripts/smooth-scroll';

    // ============================================================
    // Work page controllers are transition-aware (Astro ClientRouter).
    // Neither startCardFx nor startWorkHScroll registers its own swap teardown,
    // so without this they would LEAK on leaving /work: the shared cardfx rAF
    // would keep ticking detached canvases and the hscroll scroll-listener + rAF
    // would keep firing against a torn-out gallery. We therefore:
    //   • init both on every `astro:page-load` (re-measures the pinned scroll +
    //     re-creates the cardfx loop against the freshly swapped-in nodes)
    //   • destroy() both on `astro:before-swap` (cancels rAF, removes the scroll
    //     /resize/filter listeners) so leaving /work stops every loop dead.
    // ============================================================
    let hscroll: HScrollController | null = null;
    let cardfx: CardFxController | null = null;

    const initWork = () => {
      // guard: only run on the work page (this listener lives on document and
      // would otherwise fire for every page once registered)
      const gallery = document.getElementById('projGallery');
      if (!gallery) return;

      // tear down any prior instances before re-creating (defensive)
      cardfx?.destroy();
      hscroll?.destroy();

      // ---- per-project Canvas2D background animations ----
      // One shared rAF loop drives every card's <canvas>; offscreen / filtered-out
      // cards are skipped, fps is capped, and prefers-reduced-motion is honored.
      cardfx = startCardFx(document);

      // ---- pinned horizontal-scroll gallery ----
      // Maps vertical scroll -> horizontal track translateX with inertial LERP,
      // velocity skew/streak, per-card centre-cross reveal, and a progress rail.
      // Returns null (no-op) under prefers-reduced-motion -> the grid fallback wins.
      hscroll = startWorkHScroll(document);

      // SPA-nav safety net: after a soft navigation the swapped-in layout can
      // settle a few frames late, so the controller's first measure() may read a
      // not-yet-tall section (breaking the pin). The controller re-measures on
      // the next frames AND on resize; we nudge one more re-measure shortly after
      // page-load to cover slower swaps. (No-op under reduced-motion: hscroll is
      // null and the resize handler simply isn't wired.)
      if (hscroll) {
        setTimeout(() => window.dispatchEvent(new Event('resize')), 250);
      }

      // ---- category filter chips ----
      // We toggle a `.proj--out` class instead of removing nodes, so the
      // scroll-reveal/focus state is preserved. After filtering we fire a
      // `work:filter` event so the horizontal controller re-measures track width.
      const grid = document.getElementById('projGrid');
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
      const empty = document.getElementById('projEmpty');

      function apply(filter: string) {
        const cards = Array.from(grid?.querySelectorAll<HTMLElement>('.proj') ?? []);
        let shown = 0;
        cards.forEach((card) => {
          const match = filter === 'all' || card.dataset.cat === filter;
          card.classList.toggle('proj--out', !match);
          if (match) shown++;
        });
        if (empty) empty.hidden = shown !== 0;
        // re-measure horizontal track (no-op if reduced-motion fallback is active)
        gallery?.dispatchEvent(new CustomEvent('work:filter'));
        // also snap the page back to the gallery top so the user sees the new set
        if (hscroll && gallery) {
          const top = gallery.getBoundingClientRect().top + window.scrollY;
          if (window.scrollY > top) scrollToY(top);
        }
      }

      // chips live inside <main> (swapped each nav), so these listeners die with
      // the old nodes; we re-bind against the fresh chips on every page-load.
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => {
            const on = c === chip;
            c.classList.toggle('chip--on', on);
            c.setAttribute('aria-pressed', String(on));
          });
          apply(chip.dataset.filter ?? 'all');
        });
      });
    };

    const teardownWork = () => {
      cardfx?.destroy(); cardfx = null;
      hscroll?.destroy(); hscroll = null;
    };

    document.addEventListener('astro:page-load', initWork);
    document.addEventListener('astro:before-swap', teardownWork);
  </script>
</Base>

<style>
  .sec-title { font-size: clamp(1.8rem, 1.4rem + 2.4vw, 3.2rem); margin-bottom: 2.5rem; }
  .sec-lede { max-width: 56ch; margin: -1.6rem 0 2.4rem; font-size: 1.02rem; }

  /* experience timeline */
  .xp__list { display: flex; flex-direction: column; gap: 2.5rem; }
  .xp__item { display: grid; grid-template-columns: 16px 200px 1fr; gap: 1.4rem; align-items: start; }
  .xp__rail { position: relative; height: 100%; display: flex; justify-content: center; }
  .xp__rail::before { content: ''; position: absolute; top: 6px; bottom: -2.5rem; width: 1px; background: var(--line); }
  .xp__item:last-child .xp__rail::before { display: none; }
  .xp__dot { width: 11px; height: 11px; border-radius: 50%; background: var(--cyan); margin-top: 5px; box-shadow: var(--glow-cyan); }
  .xp__when { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.76rem; padding-top: 2px; }
  .xp__kind { width: fit-content; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.62rem; padding: 0.2em 0.6em; border-radius: 100px; border: 1px solid var(--line-2); }
  .xp__kind--work { color: var(--blue-soft); border-color: rgba(0,153,255,0.3); }
  .xp__kind--research { color: var(--cyan); border-color: rgba(56,232,200,0.3); }
  .xp__role { font-size: 1.3rem; }
  .xp__org { color: var(--ink-dim); margin-top: 0.2rem; font-size: 0.95rem; }
  .xp__highlights { margin: 1.1rem 0 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .xp__highlights li { font-size: 0.95rem; color: #c2cce0; }
  .xp__highlights li::marker { color: var(--cyan); }
  .xp__link { display: inline-block; margin-top: 1.1rem; color: var(--blue-soft); font-size: 0.82rem; }
  .xp__link:hover { color: var(--cyan); }

  /* interlude */
  .interlude { position: relative; min-height: 70vh; display: flex; align-items: center; overflow: hidden; margin: 3rem 0; }
  /* anchor the molecule's canvas to the right half so it clears the quote */
  .interlude__scene { z-index: 0; left: auto; right: 0; width: 52%; }
  .interlude__text { position: relative; z-index: 2; pointer-events: none; }
  @media (max-width: 860px) { .interlude__scene { left: 0; right: 0; width: auto; opacity: 0.45; } }
  .interlude__quote { font-size: clamp(1.6rem, 1.2rem + 2.6vw, 3.4rem); max-width: 24ch; margin-top: 1rem; text-shadow: 0 4px 40px var(--bg); }
  .interlude__quote em { font-style: italic; color: var(--cyan-soft); }
  .interlude__cap { margin-top: 1.2rem; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--cyan); text-shadow: 0 2px 20px var(--bg); }

  /* projects — summary stats */
  .projstats { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; margin: -1.6rem 0 1.4rem; font-size: 0.78rem; color: var(--ink-dim); }
  .projstats b { color: var(--cyan); font-weight: 600; }
  .projstats__sep { color: var(--ink-faint); }

  /* category filter chips */
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.8rem; }
  .chip {
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.04em;
    padding: 0.4em 0.95em; border-radius: 100px;
    border: 1px solid var(--line-2); color: var(--ink-dim);
    background: rgba(255,255,255,0.015); cursor: pointer;
    transition: border-color 0.35s var(--ease), color 0.35s var(--ease), background 0.35s var(--ease), transform 0.2s var(--ease);
  }
  .chip:hover { color: var(--ink); border-color: var(--cyan); transform: translateY(-1px); }
  .chip--on { color: #021018; background: var(--cyan); border-color: var(--cyan); box-shadow: var(--glow-cyan); }
  .chip--on:hover { color: #021018; }
  .chip:focus-visible { outline: 2px solid var(--cyan-soft); outline-offset: 3px; }

  .projects__empty { color: var(--ink-faint); letter-spacing: 0.1em; padding: 2rem 0; }

  /* ============================================================
     PINNED HORIZONTAL-SCROLL GALLERY
     The .hscroll section is tall (height set by JS). Its sticky
     child locks to the viewport; the track translates in X.
     ============================================================ */
  .hscroll { position: relative; padding: 0; margin-top: 1rem; }
  .hscroll__sticky {
    position: sticky; top: 0; height: 100svh;
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  /* a faint moving scrim that streaks when you flick (velocity-reactive) */
  .hscroll__sticky::after {
    content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: linear-gradient(90deg, rgba(56,232,200,0.05), transparent 18%, transparent 82%, rgba(0,153,255,0.05));
    opacity: calc(var(--vel, 0) * 1.6);
    transition: opacity 0.5s var(--ease);
  }

  .hscroll__head { padding-top: clamp(1.6rem, 5vh, 3rem); flex-shrink: 0; }
  .hscroll__headrow { display: flex; align-items: baseline; gap: 1.2rem; flex-wrap: wrap; }
  .hscroll__title { margin-bottom: 0; }
  .hscroll .projstats { margin: 0; }
  .hscroll .filters { margin: 1rem 0 0.4rem; }
  .hscroll__hint {
    font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink-faint); margin: 0.4rem 0 0;
    animation: hintpulse 3.2s var(--ease-in-out) infinite;
  }
  @keyframes hintpulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.85; } }

  /* horizontally-clipped viewport holds the flex track, vertically centred */
  .hscroll__viewport {
    position: relative; flex: 1; min-height: 0;
    display: flex; align-items: center; overflow: hidden;
  }
  .hscroll__track {
    display: flex; align-items: stretch; gap: 1.6rem;
    /* leading/trailing padding so first card starts in from the edge and the
       last card can reach centre before the section releases */
    padding: 0 max(8vw, 2rem) 0 max(4vw, 1.2rem);
    will-change: transform;
    transform: translate3d(0,0,0);
  }

  .hscroll .projects__empty { padding: 0 max(4vw, 1.2rem); }

  /* progress rail */
  .hscroll__rail {
    flex-shrink: 0; display: flex; align-items: center; gap: 1rem;
    padding-bottom: clamp(1.4rem, 4vh, 2.4rem); padding-top: 0.4rem;
  }
  .hscroll__index { font-size: 0.74rem; letter-spacing: 0.12em; color: var(--ink-dim); flex-shrink: 0; }
  .hscroll__index b { color: var(--cyan); font-weight: 600; }
  .hscroll__bar { position: relative; flex: 1; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .hscroll__barfill {
    position: absolute; inset: 0; transform-origin: left center; transform: scaleX(0);
    background: linear-gradient(90deg, var(--blue), var(--cyan));
    box-shadow: var(--glow-cyan);
  }

  /* ---- the cards (horizontal track variant) ---- */
  .hscroll .proj {
    position: relative; display: flex; flex-direction: column;
    flex: 0 0 clamp(300px, 30vw, 420px);
    height: min(64vh, 520px); overflow: hidden;
    opacity: 0.5; filter: saturate(0.7);
    transition: opacity 0.7s var(--ease), filter 0.7s var(--ease), transform 0.7s var(--ease), border-color 0.5s var(--ease);
  }
  .proj__inner { position: relative; z-index: 1; display: flex; flex-direction: column; flex: 1; }
  .proj--feat { border-color: rgba(56,232,200,0.22); }

  /* the focused card (centre crossed mid-viewport) comes forward and sharpens */
  .hscroll .proj.is-focused {
    opacity: 1; filter: saturate(1);
    border-color: rgba(56,232,200,0.3);
    transform: translateY(-6px) scale(1.012);
  }

  /* per-project Canvas2D animation washing behind the card.
     Off-focus it sits blurred + dim (microscope out of focus); when the card
     reaches centre it "focuses" — blur->0, opacity up. Masked at the top so the
     title/blurb stay legible. */
  .cardfx-canvas {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%;
    opacity: 0.12; pointer-events: none;
    filter: blur(10px);
    transition: opacity 0.8s var(--ease), filter 0.8s var(--ease);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0.35), #000 55%);
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.35), #000 55%);
  }
  .hscroll .proj.is-focused .cardfx-canvas { opacity: 0.3; filter: blur(0px); }
  .hscroll .proj.is-focused.proj--feat .cardfx-canvas { opacity: 0.34; }
  .proj:hover .cardfx-canvas, .proj:focus-within .cardfx-canvas { opacity: 0.36; filter: blur(0px); }

  /* filtered-out cards collapse */
  .proj--out { display: none; }

  .proj__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  /* title mask-wipe: the line sits below an overflow edge and rises on focus */
  .proj__name { font-size: 1.5rem; font-family: var(--display); overflow: hidden; line-height: 1.08; }
  .proj__name-line {
    display: inline-block; transform: translateY(108%);
    transition: transform 0.8s var(--ease);
  }
  .hscroll .proj.is-focused .proj__name-line { transform: translateY(0); }
  .proj__badges { display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; flex-shrink: 0; }
  .proj__cat { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); }

  /* blurb + metric + tags stagger in once the card is focused */
  .proj__blurb, .hscroll .proj__metric, .hscroll .proj__foot {
    opacity: 0; transform: translateY(14px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .proj__blurb { margin-top: 0.8rem; font-size: 0.95rem; flex: 0 0 auto; }
  .hscroll .proj.is-focused .proj__blurb { opacity: 1; transform: none; transition-delay: 0.12s; }
  .hscroll .proj.is-focused .proj__metric { opacity: 1; transform: none; transition-delay: 0.2s; }
  .hscroll .proj.is-focused .proj__foot { opacity: 1; transform: none; transition-delay: 0.28s; }

  /* metric is always laid out in the horizontal gallery (revealed via stagger) */
  .hscroll .proj__metric {
    margin-top: 0.85rem; color: var(--cyan); font-size: 0.78rem; letter-spacing: 0.02em;
  }
  .proj__metric-mark { color: var(--cyan-soft); margin-right: 0.45em; }

  .proj__foot { margin-top: auto; padding-top: 1rem; }
  .proj__tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .tag--lang { color: var(--blue-soft); border-color: rgba(0,153,255,0.3); }
  .proj__links { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .proj__stars { font-size: 0.78rem; color: var(--amber); }
  .proj__link { color: var(--blue-soft); font-size: 0.8rem; transition: color 0.3s; }
  .proj__link:hover { color: var(--cyan); }
  .proj__link--live { color: var(--cyan); }
  .proj__link--live:hover { color: var(--cyan-soft); }

  /* accessible focus for keyboard users — also force the card into focus state */
  .proj:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-color: var(--cyan); }
  .hscroll .proj:focus-within, .hscroll .proj:focus-visible {
    opacity: 1; filter: saturate(1);
  }
  .hscroll .proj:focus-within .proj__name-line { transform: translateY(0); }
  .hscroll .proj:focus-within .proj__blurb,
  .hscroll .proj:focus-within .proj__metric,
  .hscroll .proj:focus-within .proj__foot { opacity: 1; transform: none; }

  @media (max-width: 760px) {
    .xp__item { grid-template-columns: 1fr; }
    .xp__rail { display: none; }
  }

  /* ============================================================
     REDUCED-MOTION / FALLBACK — no pin, no horizontal hijack.
     Render the track as a normal responsive vertical grid; all the
     reveal/blur/wipe transforms reset so everything is visible.
     ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .hscroll { padding: var(--section-pad, 4rem) 0; }
    .hscroll__sticky { position: static; height: auto; overflow: visible; display: block; }
    .hscroll__sticky::after { display: none; }
    .hscroll__head { padding-top: 0; }
