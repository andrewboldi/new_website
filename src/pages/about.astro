---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Scene from '@/components/Scene.astro';
import MorphBackground from '@/components/MorphBackground.astro';
import { SITE, SOCIALS } from '@/lib/site';
import { POLYMATH, COURSEWORK } from '@/lib/data';

const courseScene: Record<string, string> = {
  'Machine Learning & CS': 'gradientdescent',
  Chemistry: 'orbital',
  'Biology & Physics': 'statmech',
};

// Public-safe lab/research highlights (Caltech total synthesis) — generic terms only.
const lab = [
  {
    scene: 'routegraph',
    eyebrow: 'Total synthesis',
    title: 'Building a molecule,<br/>one bond at a time.',
    body:
      'Three years in a Caltech total-synthesis lab, mostly at the bench. I completed ' +
      '16 consecutive reaction steps toward a complex diterpenoid intermediate, plus ' +
      'shorter fragment syntheses on the side — each step purified, characterized, and ' +
      'carried forward. Roughly 1,000 hours of hands-on organic synthesis.',
    stat: '16 consecutive steps',
  },
  {
    scene: 'chromatography',
    eyebrow: 'Separation & analysis',
    title: 'Purify, characterize,<br/>repeat.',
    body:
      'The daily craft of synthesis is separation and identification: column ' +
      'chromatography and HPLC to pull one compound from a mixture, then LC/MS, GC/MS, ' +
      'and NMR to prove what you made. When an HPLC autosampler part broke, I modeled ' +
      'and 3D-printed a replacement — about $250 saved per part.',
    stat: '3D-printed HPLC part',
  },
  {
    scene: 'massspec',
    eyebrow: 'Computation & automation',
    title: 'I wrote the software<br/>the lab didn’t have.',
    body:
      'I reverse-engineered a liquid-handling robot’s M68k firmware in Ghidra to drive it ' +
      'from code — and, to prove I’d cracked the protocol, made its motors play Liszt’s ' +
      '“La Campanella.” A Python-over-serial bridge piped live reaction status into a Zoom ' +
      'chat so I could watch overnight runs from anywhere; another tool pulled 2,600 ' +
      'catalysts from a supplier’s API into a searchable catalog. For the chemistry itself: ' +
      'ORCA DFT to rationalize a key step’s selectivity, and AutoDock Vina docking against ' +
      'an AlphaFold-modeled receptor.',
    stat: 'Ghidra · ORCA · Vina',
  },
];
---

<Base title="About" description="Andrew Boldi — chemical biologist, computer scientist, pianist, and incorrigible polymath.">
  <MorphBackground />
  <div class="page-body page-body--solidtop">
  <PageHeader
    eyebrow="About · who I am"
    title="A chemist who<br/>learned to compute."
  />

  <!-- ===== BIO ===== -->
  <section class="section bio">
    <div class="wrap bio__grid">
      <div class="bio__text" data-reveal>
        <p class="bio__lead">
          I’m Andrew — I work at the seam between <strong>chemistry</strong> and
          <strong>computation</strong>: teaching machines to understand molecules,
          proteins, and the physics underneath them.
        </p>
        <p>
          Right now I’m an AI intern at <strong>Soley Therapeutics</strong>, working on
          molecular machine learning for drug discovery — explainability, generative
          chemistry, and foundation models for molecular property prediction. Before that,
          three years in <strong>Brian Stoltz’s lab at Caltech</strong>: total synthesis at
          the bench, computational modeling in ORCA, and software to automate the lab
          around me.
        </p>
        <p>
          I’m a polymath by temperament. I’ve shipped apps used by tens of thousands of
          people, reverse-engineered a lab robot’s firmware until it played Liszt, and
          turned prime numbers into music. The throughline is simple: <em>I want to solve
          the hardest problems in science, and I think computation is how we get there.</em>
        </p>
        <div class="bio__links">
          {SOCIALS.map((s) => (
            <a class="btn" href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>
          ))}
        </div>
      </div>

      <aside class="bio__side" data-reveal data-reveal-delay="120">
        <dl class="facts">
          <div><dt>Now</dt><dd>AI Intern, Soley Therapeutics</dd></div>
          <div><dt>Study</dt><dd>Chem Bio + CS, UC Berkeley</dd></div>
          <div><dt>Based</dt><dd>{SITE.location}</dd></div>
          <div><dt>Grad</dt><dd>June 2027</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- ===== AMBIENT GFP ===== -->
  <div class="protein-feature" aria-hidden="true">
    <div class="protein-feature__scene"><Scene name="protein" /></div>
    <div class="protein-feature__fade"></div>
  </div>

  <!-- ===== RESEARCH & LAB ===== -->
  <section class="section lab">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow" data-reveal>Research &amp; lab</p>
        <h2 class="display sec-title" data-reveal>Three years<br/>at the bench.</h2>
        <p class="muted lab__intro" data-reveal>
          Before the machine-learning work, I did total synthesis in Brian Stoltz’s lab at
          Caltech — making complex natural-product molecules from scratch, characterizing
          every intermediate, and writing software to automate the instruments around me.
        </p>
      </header>
      <div class="lab__rows">
        {lab.map((row, i) => (
          <article class={`lab__row ${i % 2 ? 'lab__row--alt' : ''}`} data-reveal>
            <div class="lab__scene"><Scene name={row.scene as any} /></div>
            <div class="lab__copy">
              <p class="eyebrow lab__eyebrow">{row.eyebrow}</p>
              <h3 class="display lab__title" set:html={row.title} />
              <p class="lab__body">{row.body}</p>
              <span class="lab__stat mono">{row.stat}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== POLYMATH ===== -->
  <section class="section poly">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow" data-reveal>Beyond the lab</p>
        <h2 class="display sec-title" data-reveal>The other half<br/>of the brain.</h2>
      </header>

    </div>

    <!-- full-bleed piano: breaks out of .wrap so the 6-octave keyboard never clips;
         caption stacks below the keyboard, constrained to a readable column. -->
    <div class="poly__piano" data-reveal>
      <div class="poly__piano-scene"><Scene name="piano" /></div>
      <div class="wrap poly__piano-cap">
        <p class="eyebrow">At the piano</p>
        <h3 class="display poly__piano-title">Chopin — “Revolutionary.”</h3>
        <p class="poly__piano-sub">
          I’ve performed at Carnegie Hall and Merkin Hall. This is my Étude Op. 10 No. 12
          in C minor — rendered live from the score, every note in real time. Tap the
          speaker in the corner to hear it.
        </p>
        <a class="btn poly__piano-link" href="https://youtube.com/@AndrewBoldiPiano" target="_blank" rel="noopener noreferrer">Watch me play ↗</a>
        <p class="poly__piano-credit mono">MIDI: B. Krüger · piano-midi.de (CC BY-SA) · composition public domain</p>
      </div>
    </div>

    <div class="wrap">

      <div class="poly__grid">
        {POLYMATH.map((p, i) => (
          <article class="card ticks poly__card" data-reveal data-reveal-delay={i * 70}>
            <div class="poly__top">
              <h3 class="poly__title">{p.title}</h3>
              {p.stat && <span class="poly__stat mono">{p.stat}</span>}
            </div>
            <ul class="poly__lines">
              {p.lines.map((l) => <li>{l}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CURIOSITIES ===== -->
  <section class="section curio">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow" data-reveal>Curiosities</p>
        <h2 class="display sec-title" data-reveal>Things I play with.</h2>
      </header>
      <div class="curio__grid">
        <article class="curio__tile card ticks" data-reveal>
          <div class="curio__scene"><Scene name="rubiks" /></div>
          <p class="curio__cap">Speedcubing — 9.42s, and solved blindfolded. 2×2 through 7×7, Megaminx, Square-1.</p>
        </article>
        <article class="curio__tile card ticks" data-reveal data-reveal-delay="120">
          <div class="curio__scene"><Scene name="threebody" /></div>
          <p class="curio__cap">The three-body problem — chasing conserved quantities in deterministic chaos.</p>
        </article>
        <article class="curio__tile card ticks" data-reveal data-reveal-delay="240">
          <div class="curio__scene"><Scene name="fourier" /></div>
          <p class="curio__cap">Sums of sines — turning prime numbers into music, and signal out of noise.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== COURSEWORK ===== -->
  <section class="section course">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow" data-reveal>Foundations</p>
        <h2 class="display sec-title" data-reveal>The fields I<br/>think in.</h2>
      </header>
      <div class="course__grid">
        {Object.entries(COURSEWORK).map(([area, items], i) => (
          <div class="course__col" data-reveal data-reveal-delay={i * 60}>
            <div class="course__scene"><Scene name={(courseScene[area] ?? 'lattice') as any} /></div>
            <p class="course__area mono">{area}</p>
            <ul>{items.map((c) => <li>{c}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  .sec-title { font-size: clamp(2rem, 1.4rem + 3vw, 3.6rem); margin-top: 0.5rem; }

  /* bio */
  .bio__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3.5rem; align-items: start; }
  .bio__text { font-size: 1.1rem; line-height: 1.75; color: #cdd6ea; display: flex; flex-direction: column; gap: 1.4rem; }
  .bio__lead { font-size: clamp(1.3rem, 1.1rem + 1vw, 1.7rem); line-height: 1.5; color: var(--ink); }
  .bio__text strong { color: var(--cyan-soft); font-weight: 600; }
  .bio__text em { font-family: var(--display); font-style: italic; font-size: 1.1em; color: var(--blue-soft); }
  .bio__links { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-top: 0.8rem; }

  .facts { margin: 0.5rem 0 0.6rem; display: flex; flex-direction: column; gap: 0; }
  .facts div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint); }
  .facts dd { margin: 0; text-align: right; font-size: 0.9rem; color: var(--ink); }

  /* ambient GFP — a slim, caption-less band that just appears as atmosphere */
  .protein-feature { position: relative; height: clamp(260px, 40vh, 440px); overflow: hidden; margin: 1rem 0 2rem; opacity: 0.68; pointer-events: none; }
  .protein-feature__scene { position: absolute; inset: 0; z-index: 0; }
  /* soft edge fades (top/bottom/sides) so it dissolves into the page background. */
  .protein-feature__fade { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg, var(--bg) 0%, transparent 22%, transparent 78%, var(--bg) 100%),
      linear-gradient(90deg, var(--bg) 0%, transparent 18%, transparent 82%, var(--bg) 100%); }

  /* curiosities — un-boxed: strip the card frame so each scene sits on the page */
  .curio__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem 2rem; }
  .curio__tile { padding: 0; overflow: visible; border: none; background: none; box-shadow: none; }
  /* the scene dissolves into the page via a soft radial+linear mask (no box bg, no clip) */
  .curio__scene {
    height: 300px; position: relative;
    -webkit-mask-image:
      radial-gradient(115% 120% at 50% 48%, #000 52%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image:
      radial-gradient(115% 120% at 50% 48%, #000 52%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  /* let the embedded host fill the area rather than overflow it */
  .curio__scene :global(.scene-host) { height: 100%; min-height: 0; }
  .curio__cap { padding: 0.4rem 0.6rem 0; font-size: 0.92rem; color: var(--ink-dim); text-align: center; }
  @media (max-width: 980px) { .curio__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .curio__grid { grid-template-columns: 1fr; } }

  /* research & lab */
  .lab__intro { max-width: 60ch; margin-top: 1rem; }
  .lab__rows { display: flex; flex-direction: column; gap: 2.5rem; margin-top: 2.5rem; }
  .lab__row { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; }
  .lab__row--alt { direction: rtl; }
  .lab__row--alt > * { direction: ltr; }
  /* un-boxed: no border/box bg; the scene sits on the page and dissolves at its
     edges via a soft radial+linear mask (no hard clip), like the ambient GFP. */
  .lab__scene {
    height: 360px; position: relative;
    -webkit-mask-image:
      radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
    mask-image:
      radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  /* let the inner host fill the area (no clipping of the animation) */
  .lab__scene :global(.scene-host) { height: 100%; min-height: 0; }
  .lab__eyebrow { color: var(--cyan); }
  .lab__title { font-size: clamp(1.6rem, 1.2rem + 2vw, 2.6rem); margin: 0.5rem 0 1rem; }
  .lab__body { font-size: 1.02rem; line-height: 1.7; color: #c2cce0; }
  .lab__stat { display: inline-block; margin-top: 1rem; color: var(--amber); font-size: 0.85rem;
    border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.9rem; }
  @media (max-width: 760px) {
    .lab__row, .lab__row--alt { grid-template-columns: 1fr; direction: ltr; gap: 1.2rem; }
  }

  /* polymath */
  .poly__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .poly__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .poly__title { font-size: 1.5rem; font-family: var(--display); }
  .poly__stat { color: var(--amber); font-size: 0.92rem; }
  .poly__lines { margin: 1rem 0 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .poly__lines li { font-size: 0.94rem; color: #c2cce0; }
  .poly__lines li::marker { color: var(--cyan); }

  /* polymath — featured piano, un-boxed & FULL-BLEED so the 6-octave keyboard
     never clips: spans the viewport, no border/box bg/clip, caption stacks below. */
  .poly__piano {
    position: relative; width: 100vw; left: 50%; margin-left: -50vw;
    margin-top: 0.5rem; margin-bottom: 2rem;
  }
  /* keyboard gets the whole screen width; soft horizontal mask dissolves the
     scene into the page at the left/right edges instead of a hard box cut. */
  .poly__piano-scene {
    height: clamp(360px, 42vw, 520px); width: 100%; min-width: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
  }
  .poly__piano-scene :global(.scene-host) { height: 100%; min-height: 0; }
  /* caption re-enters the readable column (it carries the .wrap class) */
  .poly__piano-cap { margin-top: -1rem; position: relative; z-index: 1; }
  .poly__piano-title { font-size: clamp(1.5rem, 1.2rem + 1.8vw, 2.4rem); margin: 0.4rem 0 0.8rem; }
  .poly__piano-sub { font-size: 1rem; line-height: 1.7; color: #c2cce0; max-width: 52ch; }
  .poly__piano-link { margin-top: 1.1rem; }
  .poly__piano-credit { margin-top: 1.1rem; font-size: 0.64rem; color: var(--ink-faint); letter-spacing: 0.03em; }
  @media (max-width: 760px) {
    .poly__piano-scene { height: clamp(280px, 50vw, 360px); }
  }

  /* coursework */
  .course__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem; }
  /* un-boxed: no border/box bg; scene dissolves into the page via a soft mask */
  .course__scene {
    height: 240px; margin-bottom: 1rem; position: relative;
    -webkit-mask-image:
      radial-gradient(125% 125% at 50% 48%, #000 50%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image:
      radial-gradient(125% 125% at 50% 48%, #000 50%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  /* the embedded scene host enforces min-height:240px; let it fill (not overflow) */
  .course__scene :global(.scene-host) { height: 100%; min-height: 0; }
  .course__area { color: var(--cyan); font-size: 0.78rem; letter-spacing: 0.08em; padding-bottom: 0.8rem; border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
  .course__col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .course__col li { font-size: 0.92rem; color: var(--ink-dim); padding-left: 1rem; position: relative; }
  .course__col li::before { content: '→'; position: absolute; left: 0; color: var(--ink-faint); }

  @media (max-width: 860px) {
    .bio__grid { grid-template-columns: 1fr; }
  }
</style>
