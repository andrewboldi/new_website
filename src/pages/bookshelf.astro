---
import Base from '@/layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const strip = (md: string) =>
  md.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*_`>#]/g, '').replace(/\s+/g, ' ').trim();

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const shelfData = books.map((b) => ({
  title: b.data.title, author: b.data.author, status: b.data.status,
  rating: b.data.rating, spine: b.data.spine, tags: b.data.tags ?? [],
  review: strip(b.body ?? ''),
}));

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const renderedPosts = await Promise.all(posts.map(async (p) => ({ post: p, Content: (await render(p)).Content })));
const writingData = posts.map((p) => ({
  title: p.data.title,
  date: new Date(p.data.date).toISOString().slice(0, 10),
  body: strip(p.body ?? ''),
  accent: '#caa86a',
}));
const fmt = (d: Date) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const payload = { books: shelfData, writings: writingData };
---

<Base title="Library" description="Andrew Boldi's library — the books shaping how he thinks, and his writing as scrolls you can unroll.">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />

  <section class="lib">
    <header class="lib__head wrap">
      <p class="eyebrow" data-reveal>The library</p>
      <h1 class="display lib__title" data-reveal>Everything I’m<br/>reading &amp; writing.</h1>
      <p class="lib__hint mono faint" data-reveal>
        hover a spine to ease it out · click a book to open it · click a scroll on the top shelf to read an essay
      </p>
    </header>
    <div class="lib__stage scene-host" id="library"></div>
  </section>

  <!-- essay reader modal — an unrolling parchment scroll (rendered markdown + KaTeX, scrollable) -->
  <div class="reader" id="reader" hidden>
    <div class="reader__backdrop" data-reader-close></div>
    <div class="reader__scrollpaper" role="dialog" aria-modal="true" aria-label="Essay">
      <button class="reader__close" data-reader-close aria-label="Close">✕</button>
      <!-- top wooden dowel: the scroll hangs from here -->
      <div class="reader__rod reader__rod--top" aria-hidden="true"><span class="reader__cap reader__cap--l"></span><span class="reader__cap reader__cap--r"></span></div>
      <!-- the parchment sheet that unfurls downward between the rods -->
      <div class="reader__sheet">
        <div class="reader__sheet-inner">
          <div class="reader__scroll">
            <header class="reader__head">
              <p class="reader__meta mono" id="reader-meta"></p>
              <h2 class="display reader__title" id="reader-title"></h2>
            </header>
            <div class="reader__body prose" id="reader-body"></div>
          </div>
        </div>
      </div>
      <!-- bottom wooden dowel: descends as the parchment unrolls -->
      <div class="reader__rod reader__rod--bottom" aria-hidden="true"><span class="reader__cap reader__cap--l"></span><span class="reader__cap reader__cap--r"></span></div>
    </div>
  </div>

  <!-- rendered essays (hidden in the page, cloned into the reader; also SEO) -->
  <div class="writing-src" aria-hidden="true">
    {renderedPosts.map((rp, i) => (
      <article class="writing-doc" data-windex={i} data-title={rp.post.data.title} data-date={fmt(rp.post.data.date)}>
        <div class="prose"><rp.Content /></div>
      </article>
    ))}
  </div>

  <div class="sr-only">
    <h2>Books</h2>
    <ul>{books.map((b) => (<li><strong>{b.data.title}</strong> — {b.data.author}. {strip(b.body ?? '')}</li>))}</ul>
  </div>

  <script type="application/json" id="library-data" set:html={JSON.stringify(payload)}></script>
</Base>

<style>
  .lib { padding-top: 6.5rem; }
  .lib__head { text-align: center; }
  .lib__title { font-size: clamp(2.4rem, 1.8rem + 4vw, 5rem); margin: 0.6rem 0 1rem; }
  .lib__hint { font-size: 0.74rem; letter-spacing: 0.08em; max-width: 64ch; margin: 0 auto; }
  .lib__stage { width: 100%; height: clamp(540px, 84vh, 1040px); margin-top: 1.2rem;
    background: radial-gradient(120% 90% at 50% 8%, rgba(0,153,255,0.06), transparent 60%); }
  .writing-src { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  @media (max-width: 760px) { .lib { padding-top: 5.5rem; } }
</style>

<style is:global>
  /* ===== essay reader — an unrolling parchment scroll ===== */
  .reader { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: clamp(1rem, 4vw, 3rem); }
  .reader[hidden] { display: none; }
  .reader__backdrop { position: absolute; inset: 0; background: rgba(4,6,12,0.72); backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.5s var(--ease); }
  .reader.show .reader__backdrop { opacity: 1; }

  /* the whole scroll: top rod, parchment sheet, bottom rod stacked vertically.
     --unroll (0 → 1) drives the reveal. sheet height grows from the top rod and
     the bottom rod rides down with it. content sits at full size inside an
     overflow clip that grows, so text is revealed (never scaled / squished). */
  .reader__scrollpaper {
    --unroll: 0;
    position: relative; z-index: 1; width: min(720px, 100%);
    display: flex; flex-direction: column; align-items: stretch;
    filter: drop-shadow(0 40px 90px rgba(0,0,0,0.7));
    opacity: 0; transition: opacity 0.3s var(--ease);
    transform-origin: top center;
  }
  .reader.show .reader__scrollpaper { opacity: 1; }

  /* wooden dowels (rods) */
  .reader__rod {
    position: relative; height: 22px; flex: none; z-index: 3; margin: 0 -14px; border-radius: 11px;
    background:
      linear-gradient(180deg, rgba(255,235,200,0.45), transparent 40%),
      linear-gradient(180deg, #7a5f3c 0%, #5c4527 45%, #3f2f1a 100%);
    box-shadow: inset 0 2px 3px rgba(255,225,180,0.35), inset 0 -4px 6px rgba(0,0,0,0.45), 0 2px 5px rgba(0,0,0,0.4);
  }
  .reader__rod::after { /* subtle lengthwise grain */
    content: ''; position: absolute; inset: 0; border-radius: inherit; opacity: 0.25;
    background: repeating-linear-gradient(90deg, rgba(0,0,0,0.18) 0 2px, transparent 2px 9px);
  }
  .reader__cap { position: absolute; top: 50%; width: 16px; height: 30px; transform: translateY(-50%); border-radius: 6px;
    background: radial-gradient(circle at 35% 35%, #8a6c45, #4a371f 70%, #2c2012);
    box-shadow: inset 0 1px 2px rgba(255,225,180,0.4), 0 2px 5px rgba(0,0,0,0.5); }
  .reader__cap--l { left: -8px; }
  .reader__cap--r { right: -8px; }
  .reader__rod--bottom { z-index: 2; }

  /* the parchment sheet — grows from 0 height under the top rod */
  .reader__sheet {
    position: relative; overflow: hidden; z-index: 1;
    /* sheet height = unroll fraction of the available reading height */
    height: calc(var(--unroll) * var(--reader-h, 72vh));
    margin: -2px 0; /* tuck slightly under the rods so no seam shows */
    border-left: 1px solid rgba(120,96,48,0.35); border-right: 1px solid rgba(120,96,48,0.35);
    background:
      radial-gradient(140% 80% at 50% 0%, rgba(255,250,235,0.10), transparent 55%),
      radial-gradient(120% 60% at 50% 100%, rgba(120,90,40,0.10), transparent 60%),
      linear-gradient(180deg, #efe6cd, #e7dcbd 60%, #e2d6b4);
    box-shadow:
      inset 0 14px 22px -14px rgba(80,55,20,0.55),   /* shadow where paper meets top rod */
      inset 0 -14px 22px -14px rgba(80,55,20,0.55),  /* shadow where paper meets bottom rod */
      inset 6px 0 14px -12px rgba(120,90,40,0.30),
      inset -6px 0 14px -12px rgba(120,90,40,0.30);
    transition: height 1.05s var(--ease);
  }
  /* faint fibrous parchment texture + soft mottling */
  .reader__sheet::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.55; mix-blend-mode: multiply;
    background:
      radial-gradient(60% 40% at 20% 25%, rgba(150,120,60,0.10), transparent 60%),
      radial-gradient(50% 50% at 80% 70%, rgba(120,90,40,0.10), transparent 60%),
      repeating-linear-gradient(94deg, rgba(120,95,45,0.05) 0 3px, transparent 3px 7px);
  }
  /* deckled / curled side edges */
  .reader__sheet::after {
    content: ''; position: absolute; inset: 0 0 0 0; pointer-events: none; border-radius: 2px;
    box-shadow: inset 3px 0 6px -3px rgba(60,40,15,0.4), inset -3px 0 6px -3px rgba(60,40,15,0.4);
  }

  /* inner holds content at FULL natural size; the growing sheet clips it (top-anchored)
     so text is progressively revealed rather than vertically scaled */
  .reader__sheet-inner { position: absolute; top: 0; left: 0; right: 0; height: var(--reader-h, 72vh); }

  .reader__close { position: absolute; top: -42px; right: -2px; z-index: 5; width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid rgba(255,250,235,0.25); background: rgba(20,16,10,0.55); color: #efe6cd; cursor: pointer; font-size: 0.9rem;
    opacity: 0; transition: background 0.3s, transform 0.3s, opacity 0.3s var(--ease); }
  .reader.show .reader__close { opacity: 1; }
  .reader__close:hover { background: rgba(60,46,24,0.85); transform: rotate(90deg); }

  .reader__scroll { height: 100%; overflow-y: auto; overflow-x: hidden; padding: clamp(1.6rem, 4.5vw, 3rem); padding-top: clamp(1.4rem, 3.5vw, 2.4rem);
    scrollbar-width: thin; scrollbar-color: rgba(120,90,40,0.45) transparent; }
  .reader__scroll::-webkit-scrollbar { width: 11px; }
  .reader__scroll::-webkit-scrollbar-track { background: transparent; margin: 6px 0; }
  .reader__scroll::-webkit-scrollbar-thumb { background: linear-gradient(180deg, rgba(120,90,40,0.5), rgba(90,66,28,0.5)); border-radius: 10px; border: 2px solid transparent; background-clip: padding-box; }
  .reader__scroll::-webkit-scrollbar-thumb:hover { background: rgba(120,90,40,0.7); background-clip: padding-box; }
  .reader__head { border-bottom: 1px solid rgba(80,60,30,0.25); padding-bottom: 1.2rem; margin-bottom: 1.6rem; }
  .reader__meta { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: #8a6a2a; }
  .reader__title { font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); color: #241c0e; margin-top: 0.5rem; line-height: 1.05; }

  /* ink-on-parchment prose */
  .reader__body.prose { max-width: none; color: #2c2414; font-size: 1.12rem; line-height: 1.8; font-family: 'Instrument Serif', Georgia, serif; }
  .reader__body.prose > * + * { margin-top: 1.3rem; }
  .reader__body.prose h2 { font-size: 1.7rem; color: #1c1609; margin-top: 2.4rem; font-family: 'Instrument Serif', Georgia, serif; }
  .reader__body.prose h3 { font-size: 1.35rem; color: #1c1609; margin-top: 1.8rem; }
  .reader__body.prose strong { color: #1c1609; }
  .reader__body.prose em { color: #6a4f1e; }
  .reader__body.prose a { color: #7a4a12; text-decoration: underline; }
  .reader__body.prose code { font-family: var(--mono); font-size: 0.86em; background: rgba(120,90,40,0.14); padding: 0.12em 0.4em; border-radius: 5px; color: #4a3210; }
  .reader__body.prose pre { background: #2a2417; color: #e8dfc8; border-radius: 10px; padding: 1.1rem; overflow-x: auto; }
  .reader__body.prose pre code { background: none; color: inherit; }
  .reader__body.prose blockquote { border-left: 3px solid #b6924a; padding-left: 1.1rem; font-style: italic; color: #5a4620; }
  .reader__body.prose ol, .reader__body.prose ul { padding-left: 1.4rem; }
  .reader__body.prose li { margin-top: 0.5rem; }
  .reader__body.prose li::marker { color: #9a7a30; }
  .reader__body.prose hr { border: 0; border-top: 1px solid rgba(80,60,30,0.25); margin: 2rem 0; }
  .reader__body.prose .footnotes { margin-top: 2.4rem; padding-top: 1.2rem; border-top: 1px solid rgba(80,60,30,0.25); font-size: 0.92rem; }
  @media (prefers-reduced-motion: reduce) {
    .reader__scrollpaper, .reader__backdrop, .reader__sheet, .reader__close { transition: none !important; }
  }
</style>

<script>
  import { mount } from '@/lib/three/core';
  import { library3D } from '@/lib/three/Library3D';

  const el = document.getElementById('library-data');
  const payload = el ? JSON.parse(el.textContent || '{}') : { books: [], writings: [] };
  if (payload.books?.length) {
    mount('#library', (h) => library3D(h, payload), { bloom: { strength: 0.22, radius: 0.5, threshold: 0.92 }, shadows: true, solid: true });
  }

  // ---- essay reader — the modal IS an unrolling parchment scroll ----
  const reader = document.getElementById('reader');
  const paper = reader?.querySelector('.reader__scrollpaper') as HTMLElement | null;
  const body = document.getElementById('reader-body');
  const titleEl = document.getElementById('reader-title');
  const metaEl = document.getElementById('reader-meta');
  const scrollEl = reader?.querySelector('.reader__scroll') as HTMLElement | null;
  let openTimer: number | undefined;
  let closeTimer: number | undefined;
  let isOpen = false;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ROLL_MS = reduce ? 0 : 1050; // matches the sheet height transition

  // The parchment unrolls to this height. Sized to the viewport so it stays on
  // screen, leaving room for the rods + close button.
  const sizeReader = () => {
    const h = Math.min(window.innerHeight * 0.82, 880);
    paper?.style.setProperty('--reader-h', `${Math.round(h)}px`);
  };
  sizeReader();
  window.addEventListener('resize', sizeReader);

  const showReader = (ref: number) => {
    const src = document.querySelector(`.writing-doc[data-windex="${ref}"]`);
    if (!src || !reader || !body || !paper) return;
    clearTimeout(closeTimer);
    body.innerHTML = src.querySelector('.prose')?.innerHTML ?? '';
    if (titleEl) titleEl.textContent = src.getAttribute('data-title') || '';
    if (metaEl) metaEl.textContent = `Essay · ${src.getAttribute('data-date') || ''}`;
    if (scrollEl) scrollEl.scrollTop = 0;
    sizeReader();
    paper.style.setProperty('--unroll', '0'); // start rolled up (just the rod)
    reader.hidden = false;
    isOpen = true;
    // two frames: ensure hidden→shown + unroll:0 are committed before we unroll to 1,
    // so the height transition actually runs (no instant pop).
    requestAnimationFrame(() => {
      reader.classList.add('show');
      requestAnimationFrame(() => paper.style.setProperty('--unroll', '1'));
    });
  };

  const hideReader = () => {
    if (!reader || !paper || !isOpen) return;
    isOpen = false;
    clearTimeout(openTimer);
    paper.style.setProperty('--unroll', '0'); // roll the parchment back up
    reader.classList.remove('show');
    clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => { reader.hidden = true; }, ROLL_MS);
    window.dispatchEvent(new CustomEvent('book:set', { detail: -1 })); // re-roll the 3D scroll
  };

  // The reader opens EVENT-DRIVEN: Library3D fires `library:scroll-ready` at the
  // exact frame the 3D scroll's take-out + unroll finishes, so the HTML parchment
  // begins its own unroll cleanly AFTER the 3D scroll has fully presented — one
  // continuous, uninterrupted sequence (never a mid-animation pop). `library:open`
  // only records the pending scroll + arms a safety fallback (and handles close).
  let pendingRef = -1;
  const READY_FALLBACK_MS = reduce ? 0 : 5200; // > the 3D scroll's ~4.6s open dur

  const openPending = () => {
    if (pendingRef < 0) return;
    const ref = pendingRef;
    pendingRef = -1;
    clearTimeout(openTimer);
    showReader(ref);
  };

  window.addEventListener('library:open', (e) => {
    const { kind, ref } = (e as CustomEvent).detail || {};
    if (kind === 'scroll' && ref >= 0) {
      pendingRef = ref;
      // Safety net only: if the 3D completion event never arrives, still open.
      clearTimeout(openTimer);
      openTimer = window.setTimeout(openPending, READY_FALLBACK_MS);
    } else if (kind !== 'scroll') {
      pendingRef = -1;
      clearTimeout(openTimer);
      hideReader();
    }
  });
  // Normal path: open precisely when the 3D scroll animation has fully completed.
  window.addEventListener('library:scroll-ready', () => openPending());
  document.querySelectorAll('[data-reader-close]').forEach((b) => b.addEventListener('click', hideReader));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) hideReader(); });
</script>
