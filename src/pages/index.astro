---
import Base from '@/layouts/Base.astro';
import MorphBackground from '@/components/MorphBackground.astro';
import { SITE, SOCIALS, url } from '@/lib/site';
import { FIELDS, PROJECTS } from '@/lib/data';
import { getCollection } from 'astro:content';

const featured = PROJECTS.filter((p) => p.featured).slice(0, 3);

let posts: any[] = [];
try {
  posts = (await getCollection('blog'))
    .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
    .slice(0, 3);
} catch { /* collection may be empty during early build */ }
---

<Base>
  <!-- persistent morphing background; transforms through Andrew's fields on scroll -->
  <MorphBackground />

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero__veil"></div>
    <div class="wrap hero__content">
      <p class="eyebrow hero__eyebrow" data-h="0">{SITE.school} · Chem Bio × CS</p>
      <h1 class="display hero__title">
        <span class="hero__line" data-h="1">Andrew</span>
        <span class="hero__line hero__line--accent" data-h="2">Boldi</span>
      </h1>
      <p class="hero__lede" data-h="3">
        I solve the hardest problems in science with computation — teaching machines
        the language of <em>molecules</em>, <em>proteins</em>, and <em>matter</em>.
      </p>
      <div class="hero__actions" data-h="4">
        <a class="btn btn--solid" href={url('/work')}>Selected work</a>
        <a class="btn" href={url('/about')}>Who I am</a>
      </div>
      <ul class="hero__socials" data-h="5">
        {SOCIALS.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}<span class="faint"> ↗</span></a></li>
        ))}
      </ul>
    </div>

    <div class="hero__scroll" data-h="5" aria-hidden="true">
      <span class="mono">scroll to transform</span>
      <span class="hero__scroll-line"></span>
    </div>
    <div class="hero__readout mono" aria-hidden="true"><span>◎ {SITE.location}</span></div>
  </section>

  <div class="page-body">
    <!-- ================= CURRENTLY ================= -->
    <section class="section now">
      <div class="wrap">
        <div class="rule" data-reveal>// status</div>
        <p class="now__text display" data-reveal>
          Currently an <a href="https://github.com/andrewboldi">AI intern</a> at
          <span class="hl">Soley Therapeutics</span> doing molecular machine learning for
          drug discovery — and finishing a B.S. in Chemical Biology and a B.A. in Computer
          Science at <span class="hl">UC&nbsp;Berkeley</span>.
        </p>
      </div>
    </section>

    <!-- ================= FIELDS ================= -->
    <section class="section fields" id="fields">
      <div class="wrap">
        <header class="sec-head">
          <p class="eyebrow" data-reveal>What I work on</p>
          <h2 class="display sec-title" data-reveal>Six fields, one question:<br/>how does matter compute?</h2>
        </header>
        <div class="fields__grid">
          {FIELDS.map((f, i) => (
            <article class={`card ticks field field--${f.accent}`} data-reveal data-reveal-delay={i * 60}>
              <span class="field__idx mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="field__title">{f.title}</h3>
              <p class="field__blurb muted">{f.blurb}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= SELECTED WORK ================= -->
    <section class="section work-teaser">
      <div class="wrap">
        <header class="sec-head sec-head--row">
          <div>
            <p class="eyebrow" data-reveal>Selected work</p>
            <h2 class="display sec-title" data-reveal>Things I’ve built<br/>and figured out.</h2>
          </div>
          <a class="btn" href={url('/work')} data-reveal>All work →</a>
        </header>
        <div class="work-teaser__list">
          {featured.map((p, i) => (
            <a class="wt" href={p.link?.href ?? url('/work')} target={p.link ? '_blank' : undefined} rel="noopener noreferrer" data-reveal data-reveal-delay={i * 80}>
              <span class="wt__no mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="wt__body">
                <span class="wt__name">{p.name}</span>
                <span class="wt__blurb muted">{p.blurb}</span>
                <span class="wt__tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</span>
              </span>
              <span class="wt__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= WRITING + BOOKS ================= -->
    <section class="section split">
      <div class="wrap split__grid">
        <div class="split__col" data-reveal>
          <p class="eyebrow">Writing</p>
          <h2 class="display split__title">From the notebook</h2>
          <ul class="post-list">
            {posts.length === 0 && <li class="muted">Notes are loading…</li>}
            {posts.map((p) => (
              <li>
                <a href={url(`/blog/${p.id ?? p.slug}`)}>
                  <span class="post-list__title">{p.data.title}</span>
                  <span class="post-list__meta mono faint">{new Date(p.data.date).toISOString().slice(0, 10)}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="btn btn--ghost" href={url('/blog')}>All writing →</a>
        </div>

        <div class="split__col" data-reveal data-reveal-delay="120">
          <p class="eyebrow">Bookshelf</p>
          <h2 class="display split__title">What I’m reading</h2>
          <p class="muted split__books-blurb">
            A living shelf of the books shaping how I think — biology, ML, physics,
            chemistry, and the occasional detour. Each with a few honest words.
          </p>
          <a class="btn btn--ghost" href={url('/bookshelf')}>Open the shelf →</a>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section class="section contact">
      <div class="wrap center">
        <p class="eyebrow" data-reveal>Get in touch</p>
        <h2 class="display contact__title" data-reveal>Let’s build something<br/>that matters.</h2>
        <a class="btn btn--solid contact__btn" href={`mailto:${SITE.email}`} data-reveal>{SITE.email}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; z-index: 1; }
  .hero__veil {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      linear-gradient(95deg, rgba(6,8,15,0.8) 0%, rgba(6,8,15,0.42) 32%, rgba(6,8,15,0.08) 56%, transparent 76%),
      linear-gradient(180deg, rgba(6,8,15,0.5) 0%, transparent 30%);
  }
  .hero__content { position: relative; z-index: 2; padding-top: 7rem; padding-bottom: 6rem; }
  .hero__eyebrow { margin-bottom: 1.4rem; }
  .hero__title { font-size: clamp(4rem, 14vw, 12rem); display: flex; flex-direction: column; }
  .hero__line { display: block; }
  .hero__line--accent {
    background: linear-gradient(96deg, var(--blue), var(--cyan) 60%, var(--cyan-soft));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    width: fit-content;
  }
  .hero__lede {
    max-width: 40ch; margin-top: 1.6rem; font-size: clamp(1.1rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.5; color: var(--ink-dim);
  }
  .hero__lede em { font-family: var(--display); font-style: italic; font-size: 1.12em; color: var(--cyan-soft); }
  .hero__actions { display: flex; gap: 0.9rem; margin-top: 2.2rem; flex-wrap: wrap; }
  .hero__socials { list-style: none; display: flex; gap: 1.4rem; margin-top: 2.4rem; padding: 0; flex-wrap: wrap; }
  .hero__socials a { font-family: var(--mono); font-size: 0.82rem; color: var(--ink-dim); transition: color 0.3s; }
  .hero__socials a:hover { color: var(--cyan); }

  .hero__scroll { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; color: var(--ink-faint); }
  .hero__scroll .mono { font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase; }
  .hero__scroll-line { width: 1px; height: 46px; background: linear-gradient(var(--cyan), transparent); animation: scrollpulse 2.4s var(--ease-in-out) infinite; transform-origin: top; }
  @keyframes scrollpulse { 0%,100% { transform: scaleY(0.4); opacity: 0.4; } 50% { transform: scaleY(1); opacity: 1; } }
  .hero__readout { position: absolute; bottom: 2rem; right: var(--gut); z-index: 2; font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.06em; }
  @media (max-width: 760px) { .hero__readout, .hero__scroll { display: none; } }

  [data-h] { opacity: 0; transform: translateY(26px); animation: heroIn 1s var(--ease) forwards; }
  [data-h='0'] { animation-delay: 0.15s; } [data-h='1'] { animation-delay: 0.3s; }
  [data-h='2'] { animation-delay: 0.42s; } [data-h='3'] { animation-delay: 0.62s; }
  [data-h='4'] { animation-delay: 0.78s; } [data-h='5'] { animation-delay: 0.92s; }
  @keyframes heroIn { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { [data-h] { opacity: 1; transform: none; animation: none; } }

  /* page-body + field styles live in global.css (shared across pages) */

  /* ---------- now ---------- */
  .now { padding-block: clamp(4rem, 9vh, 7rem); }
  .now__text { font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem); line-height: 1.18; max-width: 24ch; margin-top: 1.6rem; }
  .now__text .hl { color: var(--cyan-soft); }
  .now__text a { color: var(--blue-soft); }

  /* ---------- section heads ---------- */
  .sec-head { margin-bottom: 3rem; }
  .sec-head--row { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .sec-title { font-size: clamp(2rem, 1.4rem + 3vw, 3.6rem); margin-top: 0.6rem; }
  .eyebrow { display: block; }

  /* ---------- fields ---------- */
  .fields__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .field { min-height: 220px; display: flex; flex-direction: column; }
  .field__idx { font-size: 0.72rem; color: var(--ink-faint); }
  .field__title { font-size: 1.35rem; margin-top: 0.8rem; }
  .field__blurb { margin-top: 0.7rem; font-size: 0.94rem; }
  .field--blue:hover { border-color: rgba(0,153,255,0.4); }
  .field--cyan:hover { border-color: rgba(56,232,200,0.4); }
  .field--violet:hover { border-color: rgba(157,123,255,0.4); }
  .field--amber:hover { border-color: rgba(255,179,71,0.4); }
  .field--blue .field__title { color: var(--blue-soft); }
  .field--cyan .field__title { color: var(--cyan-soft); }
  .field--violet .field__title { color: var(--violet); }
  .field--amber .field__title { color: var(--amber); }

  /* ---------- work teaser ---------- */
  .work-teaser__list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .wt {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1.4rem; align-items: start;
    padding: 1.8rem 0.5rem; border-bottom: 1px solid var(--line);
    transition: background 0.4s var(--ease), padding 0.4s var(--ease);
  }
  .wt:hover { background: linear-gradient(90deg, rgba(0,153,255,0.06), transparent); padding-inline: 1.2rem; }
  .wt__no { color: var(--ink-faint); font-size: 0.8rem; padding-top: 0.4rem; }
  .wt__name { font-family: var(--display); font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem); display: block; transition: color 0.3s; }
  .wt:hover .wt__name { color: var(--cyan-soft); }
  .wt__blurb { display: block; margin-top: 0.5rem; max-width: 62ch; font-size: 0.95rem; }
  .wt__tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.9rem; }
  .wt__arrow { font-size: 1.4rem; color: var(--ink-faint); transition: transform 0.4s var(--ease), color 0.3s; }
  .wt:hover .wt__arrow { transform: translate(4px, -4px); color: var(--cyan); }

  /* ---------- split ---------- */
  .split__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .split__title { font-size: clamp(1.8rem, 1.4rem + 2vw, 2.8rem); margin: 0.5rem 0 1.5rem; }
  .post-list { list-style: none; padding: 0; margin: 0 0 1.6rem; }
  .post-list li { border-top: 1px solid var(--line); }
  .post-list a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1rem 0; transition: padding 0.3s var(--ease), color 0.3s; }
  .post-list a:hover { padding-left: 0.6rem; color: var(--cyan); }
  .post-list__title { font-size: 1.05rem; }
  .post-list__meta { font-size: 0.74rem; white-space: nowrap; }
  .split__books-blurb { margin: 0 0 1.6rem; max-width: 40ch; }
  .btn--ghost { width: fit-content; }

  /* ---------- contact ---------- */
  .contact { padding-block: clamp(6rem, 16vh, 11rem); }
  .contact__title { font-size: clamp(2.4rem, 1.6rem + 4vw, 5rem); margin: 0.8rem 0 2.4rem; }
  .contact__btn { font-size: 0.95rem; }

  @media (max-width: 760px) {
    .split__grid { grid-template-columns: 1fr; }
    .wt { grid-template-columns: auto 1fr; }
    .wt__arrow { display: none; }
  }
</style>
