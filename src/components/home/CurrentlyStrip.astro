---
/**
 * Live "currently" strip — three at-a-glance facts that float over the field.
 * No card boxes; each item is a hairline-separated cell with a soft scrim so it
 * reads against the morphing particles without a hard divider.
 */
const items = [
  { k: 'role', label: 'AI Intern', detail: 'Soley Therapeutics', accent: 'cyan' },
  { k: 'study', label: 'UC Berkeley', detail: 'Chem Bio · CS', accent: 'blue' },
  { k: 'grad', label: 'Class of', detail: 'June 2027', accent: 'violet' },
];
---

<section class="now-strip" aria-label="Currently" data-reveal>
  <div class="wrap">
    <ul class="now-strip__row">
      {items.map((it, i) => (
        <li class={`now-strip__cell now-strip__cell--${it.accent}`} data-reveal data-reveal-delay={i * 90}>
          <span class="now-strip__pip" aria-hidden="true"></span>
          <span class="now-strip__text">
            <span class="now-strip__label mono">{it.label}</span>
            <span class="now-strip__detail">{it.detail}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .now-strip { padding-block: clamp(1.4rem, 4vh, 2.6rem); }
  .now-strip__row {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--line); /* the 1px gaps become hairlines */
    border-radius: var(--radius); overflow: hidden;
  }
  .now-strip__cell {
    display: flex; align-items: center; gap: 0.7rem;
    padding: 1.05rem clamp(0.9rem, 2.4vw, 1.6rem);
    /* faint scrim so text reads; gradient, not a flat box, to blend with field */
    background: linear-gradient(180deg, rgba(9,12,22,0.62), rgba(6,8,15,0.72));
  }
  .now-strip__pip {
    width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto;
    background: var(--cyan); box-shadow: 0 0 0 0 var(--cyan);
    animation: now-pulse 2.8s var(--ease-in-out) infinite;
  }
  .now-strip__cell--blue .now-strip__pip { background: var(--blue); }
  .now-strip__cell--violet .now-strip__pip { background: var(--violet); }
  .now-strip__text { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .now-strip__label { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); }
  .now-strip__detail { font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem); color: var(--ink); margin-top: 0.18rem; }
  .now-strip__cell--cyan .now-strip__detail { color: var(--cyan-soft); }
  .now-strip__cell--blue .now-strip__detail { color: var(--blue-soft); }
  .now-strip__cell--violet .now-strip__detail { color: var(--violet); }

  @keyframes now-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(56,232,200,0.5); }
    50% { box-shadow: 0 0 0 5px rgba(56,232,200,0); }
  }
  @media (max-width: 620px) {
    .now-strip__row { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-strip__pip { animation: none; }
  }
</style>
