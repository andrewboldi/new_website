---
/**
 * Typewriter that cycles Andrew's one-liners under the hero. A blinking caret
 * types each phrase, holds, deletes, advances. For reduced-motion users it
 * renders the first phrase statically with no animation or JS-driven typing.
 */
const phrases = [
  'Solving the hardest problems in science with computation.',
  'Teaching machines the language of molecules.',
  'Total synthesis at the bench, deep RL on the search tree.',
  'Explainability for molecular foundation models.',
  'A polymath by temperament.',
];
---

<p class="rotor" data-h="3" aria-label={phrases[0]}>
  <span class="rotor__txt" id="rotor-txt" aria-hidden="true">{phrases[0]}</span><span class="rotor__caret" aria-hidden="true"></span>
</p>

<script is:inline define:vars={{ phrases }}>
  (() => {
    const el = document.getElementById('rotor-txt');
    if (!el) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { el.textContent = phrases[0]; return; }

    let p = 0, i = phrases[0].length, deleting = false;
    el.textContent = phrases[0];
    const TYPE = 42, DEL = 22, HOLD = 1900, GAP = 380;

    const step = () => {
      const cur = phrases[p];
      if (!deleting) {
        i++;
        el.textContent = cur.slice(0, i);
        if (i >= cur.length) { deleting = true; return setTimeout(step, HOLD); }
        return setTimeout(step, TYPE);
      } else {
        i--;
        el.textContent = cur.slice(0, Math.max(0, i));
        if (i <= 0) { deleting = false; p = (p + 1) % phrases.length; return setTimeout(step, GAP); }
        return setTimeout(step, DEL);
      }
    };
    // start by deleting the pre-rendered first phrase after a beat
    setTimeout(() => { deleting = true; step(); }, HOLD);
  })();
</script>

<style>
  .rotor {
    margin-top: 1.1rem; min-height: 2.6em;
    font-family: var(--display); font-style: italic;
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.55rem);
    line-height: 1.35; color: var(--cyan-soft); max-width: 30ch;
  }
  .rotor__caret {
    display: inline-block; width: 2px; height: 1.05em; margin-left: 2px;
    vertical-align: -0.16em; background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan); animation: rotor-blink 1.05s steps(1) infinite;
  }
  @keyframes rotor-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .rotor { min-height: 0; }
    .rotor__caret { display: none; }
  }
</style>
