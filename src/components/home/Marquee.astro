---
/**
 * Auto-scrolling "interests" marquee. Floats over the morph field with no hard
 * edges — soft mask on both sides so it bleeds into the background instead of
 * sitting in a box. Pauses on hover; static for reduced-motion.
 */
const items = [
  'medicinal chemistry',
  'drug discovery',
  'organic synthesis',
  'structural biology',
  'deep reinforcement learning',
  'molecular machine learning',
  'biochemistry',
  'explainable AI',
  'foundation models',
  'computational chemistry',
  'electronics & making',
  'total synthesis',
];
// duplicate the track so the loop is seamless
const track = [...items, ...items];
---

<section class="marquee" aria-label="Interests" data-reveal>
  <div class="marquee__viewport">
    <ul class="marquee__track" aria-hidden="false">
      {track.map((t, i) => (
        <li class="marquee__item">
          <span class="marquee__dot" aria-hidden="true"></span>
          <span class="marquee__word">{t}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee { padding-block: clamp(2.2rem, 5vh, 3.4rem); position: relative; }
  .marquee__viewport {
    overflow: hidden;
    /* feathered edges so it dissolves into the field — no box, no seam */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee__track {
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: center; gap: 2.6rem; width: max-content;
    animation: marquee-scroll 46s linear infinite;
    will-change: transform;
  }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__item { display: inline-flex; align-items: center; gap: 0.85rem; white-space: nowrap; }
  .marquee__word {
    font-family: var(--display); font-size: clamp(1.15rem, 0.9rem + 1vw, 1.9rem);
    color: var(--ink-dim); letter-spacing: -0.01em; transition: color 0.4s var(--ease);
  }
  .marquee__item:hover .marquee__word { color: var(--cyan-soft); }
  .marquee__dot {
    width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto;
    background: var(--cyan); box-shadow: 0 0 10px var(--cyan); opacity: 0.7;
  }
  .marquee__item:nth-child(3n) .marquee__dot { background: var(--blue); box-shadow: 0 0 10px var(--blue); }
  .marquee__item:nth-child(3n+1) .marquee__dot { background: var(--violet); box-shadow: 0 0 10px var(--violet); }

  @keyframes marquee-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; flex-wrap: wrap; width: 100%; justify-content: center; gap: 0.8rem 1.8rem; }
  }
</style>
