---
/**
 * Fixed, scroll-driven morphing particle field used as a living page background.
 * Drop it once near the top of a page, then wrap the page content in
 * `<div class="page-body">` so text reads over it. Reused on home/about/work.
 *
 * Layering (back → front):
 *   .ambient-field  — slow domain-warped fBm atmosphere (depth, this component)
 *   .bg-field       — the molecular MorphField particles (existing character)
 *   .page-body      — content on a translucent scrim (global.css)
 */
---

<div class="ambient-field" id="ambient-field" aria-hidden="true"></div>
<div class="bg-field" id="bg-field" aria-hidden="true"></div>
<div class="field-tag" id="field-tag" aria-hidden="true">
  <span class="field-tag__dot"></span><span id="field-tag-label">generative diffusion → caffeine</span>
</div>

<script>
  import { mount } from '@/lib/three/core';
  import { morphField } from '@/lib/three/MorphField';
  import { ambientField } from '@/lib/three/AmbientField';
  import * as THREE from 'three';

  // Background WebGL fields. `mount()` registers its own `astro:before-swap`
  // teardown (disposes the scene + removes the canvas) and guards re-entry via
  // host.dataset.mounted, so we (re)mount on every `astro:page-load`: idempotent
  // on first paint, and re-created whenever the user lands on a page that
  // includes this background (home/work). We deliberately do NOT persist these
  // hosts — a persisted mount()-owned host would be destroyed on swap and left
  // as a blank, dead canvas. Re-mount keeps them genuinely alive + leak-free.
  const mountFields = () => {
    // Deep atmospheric layer behind the molecules. No bloom (it's a self-lit
    // gradient — bloom would raise exposure / risk blowout); cheap fixed-cost fBm,
    // so pixelRatio is capped low and it stays mobile-trivial. Reduced-motion is
    // honoured inside the module (uTime frozen) + core renders one static frame.
    const mobile = matchMedia('(max-width: 760px)').matches;
    mount('#ambient-field', (h) => ambientField(h), {
      bloom: false,
      alpha: true,
      layer: 0, // deepest background — composite UNDER everything on the shared canvas
      // Capped low: the fBm is blurred + low-opacity behind everything, so extra
      // resolution is invisible but costs fill on every frame it renders.
      maxPixelRatio: mobile ? 1.0 : 1.1,
      // FULLSCREEN fill sink: this fBm fills the whole fixed viewport every frame
      // it renders. It's already blurred (2px) + low-opacity (~0.42–0.5), so it's
      // the MOST forgiving fullscreen scene — render its buffer at 0.5× CSS res
      // (CSS upscales). The blur erases any softening; fill drops ~4× vs native at
      // 2560×1600. (Tested 0.42× too — no extra frame-time gain past the fill knee,
      // so 0.5× keeps it cleaner for the same cost.) Governor → 0.4× floor on load.
      renderScale: 0.5,
    });

    const tag = document.getElementById('field-tag');
    const label = document.getElementById('field-tag-label');
    const dot = tag?.querySelector('.field-tag__dot') as HTMLElement | null;

    mount('#bg-field', (h) =>
      morphField(h, {
        onStage: (_i, text, accent) => {
          if (label) label.textContent = text;
          if (dot) {
            const c = '#' + new THREE.Color(accent).getHexString();
            dot.style.background = c;
            dot.style.boxShadow = `0 0 12px ${c}`;
          }
        },
      }), {
        bloom: { strength: 0.35, radius: 0.5, threshold: 0.2 },
        alpha: true,
        layer: 1, // molecular field — above ambient (0), below hero (2) + content (10)
        maxPixelRatio: 1.15,
        // FULLSCREEN fill sink: the molecular morph field + its bloom pass fill the
        // whole fixed viewport. Soft additive points behind page content upscale
        // nearly invisibly, so render the buffer (and its half-res bloom mip) at
        // 0.6× CSS res — fill drops ~2.8× at 2560×1600. The governor pushes it lower
        // still under load (down toward 0.4×). Kept a touch above ambient's 0.5×
        // because the points have finer structure than the blurred fBm.
        renderScale: 0.6,
      });
  };
  document.addEventListener('astro:page-load', mountFields);
</script>

<style>
  /* Deep atmosphere: sits between the body gradient (z -2 / -1) and the
     molecular field (.bg-field, z 0). Low opacity + soft blur so it reads as
     ambient depth, never as a competing layer, and keeps text readable (the
     .page-body scrim still draws on top). pointer-events none so it never
     intercepts clicks. */
  .ambient-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.42;
    filter: blur(2px) saturate(1.05);
    will-change: opacity;
  }
  /* Slightly stronger on large screens where the depth has room to breathe. */
  @media (min-width: 1100px) {
    .ambient-field { opacity: 0.5; }
  }
  /* Calmer still on mobile — the molecules already carry the character there. */
  @media (max-width: 760px) {
    .ambient-field { opacity: 0.34; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient-field { filter: blur(2px); }
  }
</style>
