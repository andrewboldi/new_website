---
import { SITE, SOCIALS, NAV, url } from '@/lib/site';
import { CONTRIBUTIONS, intensityLevel } from '@/lib/githubContributions';
const year = new Date().getFullYear();

// Build-time snapshot of Andrew's public GitHub contribution calendar.
const { totalContributions, weeks } = CONTRIBUTIONS;
const totalLabel = totalContributions.toLocaleString('en-US');
const ghProfile = 'https://github.com/andrewboldi';
---

<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__brand">
      <p class="display foot__name">{SITE.name}</p>
      <p class="muted foot__tag">{SITE.tagline}</p>
      <p class="mono foot__loc">◎ {SITE.location}</p>
    </div>

    <nav class="foot__col" aria-label="Pages">
      <p class="eyebrow">Pages</p>
      {NAV.map((i) => <a href={url(i.path)}>{i.label}</a>)}
    </nav>

    <nav class="foot__col" aria-label="Elsewhere">
      <p class="eyebrow">Elsewhere</p>
      {SOCIALS.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">
          {s.label} <span class="faint">/ {s.handle}</span>
        </a>
      ))}
      <a href={`mailto:${SITE.email}`}>Email <span class="faint">/ say hello</span></a>
    </nav>
  </div>

  <a
    class="wrap foot__contrib"
    href={ghProfile}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${totalLabel} GitHub contributions in the last year — view Andrew's profile`}
  >
    <div class="contrib__head">
      <p class="eyebrow">GitHub</p>
      <p class="contrib__total mono">
        <strong>{totalLabel}</strong> contributions in the last year
      </p>
    </div>

    <div class="contrib__scroll">
      <div class="contrib__grid" role="img" aria-hidden="true">
        {weeks.map((week) => (
          <div class="contrib__week">
            {Array.from({ length: 7 }).map((_, d) => {
              const count = week[d];
              const has = count !== undefined;
              const lvl = has ? intensityLevel(count) : -1;
              return (
                <span
                  class="contrib__cell"
                  data-lvl={has ? lvl : 'empty'}
                  title={has ? `${count} contribution${count === 1 ? '' : 's'}` : undefined}
                />
              );
            })}
          </div>
        ))}
      </div>
    </div>

    <div class="contrib__legend mono">
      <span>Less</span>
      <span class="contrib__cell" data-lvl="0" />
      <span class="contrib__cell" data-lvl="1" />
      <span class="contrib__cell" data-lvl="2" />
      <span class="contrib__cell" data-lvl="3" />
      <span class="contrib__cell" data-lvl="4" />
      <span>More</span>
    </div>
  </a>

  <div class="wrap foot__base">
    <span class="mono">© {year} — built with three.js & a lot of curiosity</span>
    <div class="binclock-wrap" title="binary clock — Andrew made one in Python">
      <div class="binclock" id="binclock" role="img" aria-label="binary clock showing the local time"></div>
      <span class="binclock-cap mono">local time · binary</span>
    </div>
  </div>
</footer>

<style>
  /* clock + caption sit together, right-aligned in the footer base */
  .binclock-wrap { display: flex; align-items: center; gap: 0.7rem; }
  .binclock-cap { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; }
  .binclock { display: flex; gap: 7px; align-items: flex-end; }
  /* :global() so the runtime-created dots/columns (added via JS, without Astro's
     scope attribute) actually receive these styles — otherwise they render 0px. */
  .binclock :global(.binclock__col) { display: flex; flex-direction: column-reverse; gap: 5px; }
  .binclock :global(.binclock__dot) {
    width: 9px; height: 9px; border-radius: 50%;
    background: color-mix(in srgb, var(--ink-faint) 45%, transparent);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: background 0.3s, box-shadow 0.3s;
  }
  .binclock :global(.binclock__dot.on) {
    background: var(--cyan);
    box-shadow: 0 0 9px var(--cyan), 0 0 2px var(--cyan);
  }
  @media (max-width: 760px) { .binclock-wrap { display: none; } }
</style>

<script>
  const root = document.getElementById('binclock');
  if (root) {
    const heights = [2, 4, 3, 4, 3, 4]; // bits per BCD column: H10 H1 M10 M1 S10 S1
    const dots: HTMLElement[][] = heights.map((h) => {
      const col = document.createElement('div'); col.className = 'binclock__col';
      const cd: HTMLElement[] = [];
      for (let i = 0; i < h; i++) { const d = document.createElement('div'); d.className = 'binclock__dot'; col.appendChild(d); cd.push(d); }
      root.appendChild(col); return cd;
    });
    const tick = () => {
      const n = new Date();
      const digits = [Math.floor(n.getHours() / 10), n.getHours() % 10, Math.floor(n.getMinutes() / 10), n.getMinutes() % 10, Math.floor(n.getSeconds() / 10), n.getSeconds() % 10];
      digits.forEach((val, c) => dots[c].forEach((d, b) => d.classList.toggle('on', !!((val >> b) & 1))));
    };
    tick(); setInterval(tick, 1000);
  }
</script>


<style>
  /* relative + z-index keeps the footer above the fixed background canvas (clickable). */
  .foot { position: relative; z-index: 2; border-top: 1px solid var(--line); margin-top: 4rem; padding-block: 4rem 2rem; background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 100%); }
  .foot__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 2.5rem; }
  .foot__name { font-size: clamp(2rem, 6vw, 3rem); }
  .foot__tag { max-width: 30ch; margin-top: 0.4rem; }
  .foot__loc { margin-top: 1rem; font-size: 0.78rem; color: var(--cyan); letter-spacing: 0.08em; }
  .foot__col { display: flex; flex-direction: column; gap: 0.7rem; }
  .foot__col .eyebrow { margin-bottom: 0.5rem; }
  .foot__col a { position: relative; color: var(--ink-dim); transition: color 0.35s var(--ease); width: fit-content; }
  .foot__col a::after {
    content: ''; position: absolute; left: 0; bottom: -3px; height: 1px; width: 100%;
    background: linear-gradient(90deg, var(--cyan), var(--blue));
    transform: scaleX(0); transform-origin: left; transition: transform 0.45s var(--ease);
  }
  .foot__col a:hover { color: var(--cyan); }
  .foot__col a:hover::after { transform: scaleX(1); }
  .foot__col a .faint { transition: color 0.35s; }
  .foot__col a:hover .faint { color: var(--cyan-soft); }
  .foot__base { display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--ink-faint); font-size: 0.72rem; }

  /* GitHub contribution heatmap — full-width row above the footer base. */
  .foot__contrib {
    display: block; margin-top: 3rem; padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    text-decoration: none; color: inherit;
  }
  .contrib__head { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .contrib__head .eyebrow { margin: 0; }
  .contrib__total { font-size: 0.74rem; color: var(--ink-dim); transition: color 0.35s var(--ease); }
  .contrib__total strong { color: var(--cyan); font-weight: 600; }
  .foot__contrib:hover .contrib__total { color: var(--ink); }

  /* horizontal scroll guard so the ~53-week grid never forces page overflow */
  .contrib__scroll { overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
  .contrib__scroll::-webkit-scrollbar { height: 6px; }
  .contrib__scroll::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 3px; }

  .contrib__grid { display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 3px; width: max-content; }
  .contrib__week { display: grid; grid-template-rows: repeat(7, 1fr); gap: 3px; }
  .contrib__cell {
    width: 11px; height: 11px; border-radius: 2px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  /* 5-step intensity scale: faint surface → site cyan/blue. */
  .contrib__cell[data-lvl='empty'] { background: transparent; box-shadow: none; }
  .contrib__cell[data-lvl='0'] { background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--line); }
  .contrib__cell[data-lvl='1'] { background: color-mix(in srgb, var(--blue) 28%, var(--surface-2)); box-shadow: inset 0 0 0 1px var(--line-2); }
  .contrib__cell[data-lvl='2'] { background: color-mix(in srgb, var(--blue) 55%, var(--cyan) 10%); box-shadow: none; }
  .contrib__cell[data-lvl='3'] { background: color-mix(in srgb, var(--cyan) 55%, var(--blue) 35%); box-shadow: none; }
  .contrib__cell[data-lvl='4'] { background: var(--cyan); box-shadow: 0 0 6px color-mix(in srgb, var(--cyan) 60%, transparent); }

  .contrib__legend { display: flex; align-items: center; gap: 4px; margin-top: 0.8rem; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); }
  .contrib__legend span:first-child { margin-right: 2px; }
  .contrib__legend span:last-child { margin-left: 2px; }

  @media (max-width: 760px) {
    .foot__grid { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
    .foot__base { flex-direction: column; gap: 0.6rem; text-align: center; }
    .foot__contrib { margin-top: 2rem; }
    .contrib__cell { width: 9px; height: 9px; }
    .contrib__grid, .contrib__week { gap: 2px; }
  }
</style>
