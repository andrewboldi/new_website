---
import { NAV, SITE, url } from '@/lib/site';
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
function active(path: string) {
  const target = url(path).replace(/\/$/, '') || '/';
  if (path === '/') return here === (base || '/') || here === base;
  return here.startsWith(target);
}
---

<header class="nav" id="site-nav">
  <a class="brand" href={url('/')} aria-label="Andrew Boldi — home">
    <span class="brand__mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="26" height="26">
        <circle cx="16" cy="16" r="4.2" fill="var(--cyan)"></circle>
        <circle cx="5" cy="9" r="2.4" fill="none" stroke="var(--blue)" stroke-width="1.3"></circle>
        <circle cx="27" cy="11" r="2.4" fill="none" stroke="var(--blue)" stroke-width="1.3"></circle>
        <circle cx="9" cy="26" r="2.4" fill="none" stroke="var(--blue)" stroke-width="1.3"></circle>
        <circle cx="25" cy="25" r="2.4" fill="none" stroke="var(--blue)" stroke-width="1.3"></circle>
        <g stroke="var(--line-2)" stroke-width="1.1">
          <line x1="16" y1="16" x2="5" y2="9"></line>
          <line x1="16" y1="16" x2="27" y2="11"></line>
          <line x1="16" y1="16" x2="9" y2="26"></line>
          <line x1="16" y1="16" x2="25" y2="25"></line>
        </g>
      </svg>
    </span>
    <span class="brand__name">{SITE.name}</span>
  </a>

  <nav class="nav__links" aria-label="Primary">
    {NAV.map((item) => (
      <a class:list={['nav__link', { 'is-active': active(item.path) }]} href={url(item.path)}>
        <span class="nav__idx">{String(NAV.indexOf(item) + 1).padStart(2, '0')}</span>
        {item.label}
      </a>
    ))}
  </nav>

  <button class="nav__toggle" aria-label="Toggle menu" aria-expanded="false" id="nav-toggle">
    <span></span><span></span>
  </button>
</header>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem var(--gut);
    transition: background 0.5s var(--ease), backdrop-filter 0.5s, border-color 0.5s, padding 0.4s;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    /* Glassy frosted bar. backdrop-filter blur is CHEAP here — it's ONE small
       fixed element (not a scroll surface), so it never re-blurs page content
       on scroll. A faint cool tint + a 1px top sheen highlight read as glass. */
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--bg) 60%, transparent), color-mix(in srgb, var(--bg) 74%, transparent));
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
    box-shadow:
      inset 0 1px 0 0 rgba(190, 215, 255, 0.10),
      0 8px 24px -16px rgba(0, 8, 22, 0.55);
    padding-block: 0.8rem;
  }
  /* Fallback for browsers without backdrop-filter: a more opaque tint so the
     bar stays legible and still reads as a glassy surface (no live blur). */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav.scrolled { background: color-mix(in srgb, var(--bg) 92%, transparent); }
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; }
  .brand__mark { display: grid; place-items: center; transition: transform 0.6s var(--ease); }
  .brand:hover .brand__mark { transform: rotate(120deg); }
  .brand__name { font-family: var(--display); font-size: 1.32rem; letter-spacing: 0.01em; }

  .nav__links { display: flex; gap: 0.3rem; }
  .nav__link {
    position: relative; display: inline-flex; align-items: baseline; gap: 0.4em;
    font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.02em;
    padding: 0.5em 0.85em; border-radius: 100px; color: var(--ink-dim);
    transition: color 0.3s, background 0.3s;
  }
  .nav__idx { font-size: 0.6rem; color: var(--ink-faint); transition: color 0.3s; }
  .nav__link:hover { color: var(--ink); background: rgba(255,255,255,0.03); }
  .nav__link.is-active { color: var(--cyan); }
  .nav__link.is-active .nav__idx { color: var(--cyan); }

  .nav__toggle { display: none; background: none; border: 0; cursor: pointer; padding: 0.5rem; }
  .nav__toggle span { display: block; width: 24px; height: 1.6px; background: var(--ink); margin: 5px 0; transition: transform 0.4s var(--ease), opacity 0.3s; }

  @media (max-width: 760px) {
    .nav__toggle { display: block; }
    .nav__links {
      position: fixed; inset: 0 0 auto 0; top: 0; flex-direction: column; gap: 0.4rem;
      padding: 6rem var(--gut) 2.5rem; background: color-mix(in srgb, var(--bg) 90%, transparent);
      backdrop-filter: blur(18px); border-bottom: 1px solid var(--line);
      box-shadow: inset 0 1px 0 0 rgba(190, 215, 255, 0.10), 0 18px 40px -24px rgba(0, 8, 22, 0.6);
      transform: translateY(-100%); transition: transform 0.5s var(--ease); pointer-events: none;
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .nav__links { background: color-mix(in srgb, var(--bg) 98%, transparent); }
    }
    .nav.open .nav__links { transform: none; pointer-events: auto; }
    .nav__link { font-size: 1rem; padding: 0.7em 0.4em; }
    .nav.open .nav__toggle span:first-child { transform: translateY(6.6px) rotate(45deg); }
    .nav.open .nav__toggle span:last-child { transform: translateY(-6.6px) rotate(-45deg); }
  }
</style>

<script>
  // The nav is `transition:persist`ed, so this DOM node (and the listeners we
  // bind below) survive every client-side navigation — bind ONCE, guarded, so
  // the scroll/toggle handlers never stack. Only the active-link highlight is
  // page-dependent, so we recompute that on each `astro:page-load`.
  if (!(window as any).__siteNavInit) {
    (window as any).__siteNavInit = true;
    const nav = document.getElementById('site-nav');
    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const toggle = document.getElementById('nav-toggle');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!!open));
    });
    nav?.querySelectorAll('.nav__link').forEach((a) =>
      a.addEventListener('click', () => nav.classList.remove('open')),
    );

    // keep the active link in sync with the current URL across SPA navigations
    const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
    const syncActive = () => {
      const here = location.pathname.replace(/\/$/, '') || '/';
      nav?.querySelectorAll<HTMLAnchorElement>('.nav__link').forEach((a) => {
        const target = new URL(a.href).pathname.replace(/\/$/, '') || '/';
        const isHome = target === (base || '/') || target === base;
        const on = isHome
          ? here === (base || '/') || here === base
          : here.startsWith(target);
        a.classList.toggle('is-active', on);
      });
      onScroll(); // also refresh scrolled state for the page we land on
    };
    document.addEventListener('astro:page-load', syncActive);
  }
</script>
