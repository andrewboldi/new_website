---
/**
 * Drop-in three.js scene. Renders a host the registry auto-mounts on the client.
 * Usage: <Scene name="protein" /> or <Scene name="molecule" pdb="caffeine" />
 */
import { url } from '@/lib/site';

type SceneName =
  | 'network' | 'molecule' | 'protein' | 'density' | 'landscape'
  | 'neuralnet' | 'signal' | 'orbital' | 'helix' | 'statmech' | 'lattice'
  | 'threebody' | 'rubiks'
  | 'routegraph' | 'chromatography' | 'massspec' | 'gradientdescent' | 'fourier'
  | 'piano';

interface Props {
  name: SceneName;
  /** pdb filename (without extension) for the molecule scene */
  pdb?: string;
  class?: string;
  label?: string;
  /** height when not absolutely positioned by the parent */
  height?: string;
}

const { name, pdb, class: klass = '', label, height } = Astro.props;
const labels: Record<SceneName, string> = {
  network: 'A network of molecules drifting and forming transient bonds.',
  molecule: 'A rotating ball-and-stick model of a real molecule.',
  protein: 'A protein backbone folding into its structure.',
  density: 'A molecular electron-density isosurface flexing in real time.',
  landscape: 'An energy landscape with a marker performing gradient descent.',
  neuralnet: 'A neural network with an activation wave propagating through its layers.',
  signal: 'A noisy band of points resolving into a clean travelling wave.',
  orbital: 'A d-orbital electron cloud, colored by wavefunction phase.',
  helix: 'A DNA double helix turning slowly.',
  statmech: 'A box of gas particles colored by speed — a live Maxwell–Boltzmann distribution.',
  lattice: 'A crystalline lattice of atoms.',
  threebody: 'Three masses orbiting under gravity, leaving glowing trails — the chaotic three-body problem.',
  rubiks: 'A Rubik’s cube turning its layers.',
  routegraph: 'A retrosynthesis tree of molecules, with a solution route lighting up step by step.',
  chromatography: 'A chromatography column separating a mixture into colored bands that elute over time.',
  massspec: 'A mass spectrum being acquired — m/z peaks igniting as a detector sweeps across them.',
  gradientdescent: 'A marker rolling downhill along the gradient of a glowing loss surface.',
  fourier: 'Rotating phasors summing into a wave — the Fourier series of a square wave.',
  piano: 'A glowing piano playing Chopin’s “Revolutionary” Étude — falling notes strike the keys in real time.',
};
---

<div
  class={`scene-host scene-embed ${klass}`}
  data-scene={name}
  data-pdb={pdb ? url(`/pdb/${pdb}.pdb`) : undefined}
  role="img"
  aria-label={label ?? labels[name]}
  style={height ? `height:${height}` : undefined}
>
</div>

<script>
  import { autoMountScenes } from '@/lib/three/registry';
  const run = () => autoMountScenes();
  if (document.readyState !== 'loading') run();
  else document.addEventListener('DOMContentLoaded', run);
  document.addEventListener('astro:page-load', run);
</script>

<style>
  .scene-embed { width: 100%; min-height: 240px; }
</style>
