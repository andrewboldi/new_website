---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { SITE, url } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Hide footer (e.g. for the immersive home hero handling its own). */
  bare?: boolean;
}

const { title, description = SITE.description, bare = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#06080f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@andrewboldi" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Without JS, reveal-on-scroll content must still be visible. -->
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <div class="cursor" id="cursor" aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <style>
      .cursor {
        position: fixed; top: 0; left: 0; width: 26px; height: 26px;
        border: 1px solid var(--cyan); border-radius: 50%;
        transform: translate(-50%, -50%); pointer-events: none; z-index: 9998;
        transition: width 0.25s var(--ease), height 0.25s var(--ease), background 0.25s, border-color 0.25s, opacity 0.3s;
        mix-blend-mode: screen; opacity: 0;
      }
      .cursor.hot { width: 52px; height: 52px; background: rgba(56,232,200,0.10); border-color: var(--cyan-soft); }
      .cursor.down { width: 16px; height: 16px; }
      @media (hover: none), (pointer: coarse) { .cursor { display: none; } }
    </style>

    <script>
      // ---- scroll reveal ----
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      const items = document.querySelectorAll('[data-reveal]');
      items.forEach((el, i) => {
        const delay = (el as HTMLElement).dataset.revealDelay ?? String((i % 6) * 70);
        (el as HTMLElement).style.transitionDelay = `${delay}ms`;
        io.observe(el);
      });

      // ---- custom cursor (pointer devices only) ----
      const cursor = document.getElementById('cursor');
      if (cursor && window.matchMedia('(hover: hover)').matches) {
        let x = innerWidth / 2, y = innerHeight / 2, cx = x, cy = y;
        addEventListener('pointermove', (e) => {
          x = e.clientX; y = e.clientY; cursor.style.opacity = '1';
          const hot = (e.target as HTMLElement)?.closest('a, button, [data-hot]');
          cursor.classList.toggle('hot', !!hot);
        });
        addEventListener('pointerdown', () => cursor.classList.add('down'));
        addEventListener('pointerup', () => cursor.classList.remove('down'));
        addEventListener('pointerleave', () => (cursor.style.opacity = '0'));
        const loop = () => {
          cx += (x - cx) * 0.18; cy += (y - cy) * 0.18;
          cursor.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
          requestAnimationFrame(loop);
        };
        loop();
      }
    </script>
  </body>
</html>
